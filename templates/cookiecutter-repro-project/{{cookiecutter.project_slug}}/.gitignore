# Pixi environments are rebuilt from pixi.lock, never committed
.pixi/*
!.pixi/config.toml

# Raw data is downloaded, not committed (see metadata/ and data/raw/README.md)
data/raw/**
!data/raw/README.md
# Processed data and results are regenerated by `pixi run reproduce`
data/processed/**
!data/processed/README.md
results/**
!results/README.md

# Saved container images (archive them with a release, not in Git)
containers/*.tar.gz
containers/*.sif

# Workflow manager state
.snakemake/
.nextflow/
.nextflow.log*
work/

# Quarto and Jupyter
/.quarto/
reports/*.html
reports/*_files/
**/*.quarto_ipynb
.ipynb_checkpoints/

# Python and OS clutter
__pycache__/
.DS_Store
Thumbs.db
